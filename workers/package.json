{
  "name": "hifz-deck-api",
  "version": "1.0.0",
  "description": "Cloudflare Workers API for Hifz Deck - migrated from Supabase",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "tsc",
    "db:create": "wrangler d1 create hifz_deck_db",
    "db:init": "wrangler d1 execute hifz_deck_db --file=./schema.sql",
    "db:init-local": "wrangler d1 execute hifz_deck_db --local --file=./schema.sql"
  },
  "keywords": ["cloudflare", "workers", "d1", "api"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/bcrypt": "^5.0.2",
    "bcrypt": "^5.1.1",
    "hono": "^4.6.14",
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241231.0",
    "typescript": "^5.7.3",
    "wrangler": "^3.101.1"
  }
}
